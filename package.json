{
  "name": "bb-plugin-tasks-kv",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.35",
    "bbPluginSdk": "^0.4.1"
  },
  "bb": {
    "name": "Tasks (KV)",
    "description": "Plan and track work in BB, delegate tasks to agents, and keep task context connected to worker threads.",
    "branding": {
      "icon": "ListTodo",
      "logo": {
        "light": "./upstream/logo.svg",
        "dark": "./upstream/logo-dark.svg"
      }
    },
    "server": "./upstream/server.ts",
    "app": "./upstream/app.tsx",
    "skills": [
      "./upstream/skills"
    ]
  },
  "dependencies": {
    "@bb/plugin-sdk": "file:./shims/plugin-sdk",
    "@bb/shared-ui": "file:./shims/shared-ui",
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-bubble-menu": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@tiptap/suggestion": "^2.27.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.28.0",
    "react-force-graph-2d": "^1.29.1",
    "tailwind-merge": "^3.4.0",
    "tiptap-markdown": "^0.8.10",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "bb-app": "0.38.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  },
  "scripts": {
    "gen:shim": "node scripts/gen-shared-ui-shim.mjs",
    "build": "npm run gen:shim && bb plugin build .",
    "test:graph": "vitest run --config upstream/vitest.config.ts views/graph shell/route-model.test.ts",
    "test:blocking": "vitest run --config upstream/vitest.config.ts blocking.test.ts dependencies.test.ts views/blocking views/list/list-preference.test.ts",
    "verify:release": "node scripts/verify-release.mjs",
    "check": "npm run test:graph && npm run build && npm run verify:release",
    "release": "bash scripts/release.sh",
    "sync:upstream": "bash scripts/sync-upstream.sh"
  }
}
